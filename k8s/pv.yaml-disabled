kind: PersistentVolume
apiVersion: v1
metadata:
  name: {{ .Release.Name }}-pv
  labels:
    app: {{ .Release.Name }}-pv
  namespace: {{ .Release.Namespace }}
spec:
  type: {{ .Values.pv.type }}
  capacity:
    storage: {{ .Values.pv.storage }}
  accessModes:
    - {{ .Values.pvc.accessMode }}
  persistentVolumeReclaimPolicy: {{ .Values.pv.reclaimPolicy }}
  path: {{ .Values.pv.path }}