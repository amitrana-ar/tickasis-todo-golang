# ─────────────────────────────────────────────────────────────
# Tickasis TO-DO — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your own values in .env
# 3. Never commit .env to Git (.gitignore already excludes it)
# ─────────────────────────────────────────────────────────────

# PostgreSQL database name
POSTGRES_DB=your_db_name

# PostgreSQL username
POSTGRES_USER=your_db_user

# PostgreSQL password — use a strong password in production!
POSTGRES_PASSWORD=your_strong_password_here

# Full database connection URL (must match the values above)
# Format: postgres://<user>:<password>@<host>:<port>/<db>?sslmode=disable
DATABASE_URL=postgres://your_db_user:your_strong_password_here@postgres:5432/your_db_name?sslmode=disable

# Application environment (development | production)
APP_ENV=production

# Port the app listens on
APP_PORT=8080
